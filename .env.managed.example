# Не копируйте эти примеры как реальные секреты. Сгенерируйте .env.managed:
# node scripts/init-managed-env.mjs https://gitlab.example.com
# При GitLab.com используйте https://gitlab.com; несколько origins — через запятую.
SETTINGS_GITLAB_ORIGINS=https://gitlab.example.com
# 32 random bytes encoded as hex, to avoid URL escaping in the database URL.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX
TASK_TRACKER_SYSTEM_TOKEN=REPLACE_WITH_GENERATED_ADMIN_TOKEN
# 32 random bytes, canonical base64; keep a secure backup separate from PostgreSQL.
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64
# Либо отдельно авторизуйте Codex в собственном Docker volume.
CODEX_API_KEY=
