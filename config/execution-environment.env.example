# Дополнение к .env worker. Этот файл не загружается автоматически.
# Документация: docs/EXECUTION_ENVIRONMENT.md
# Пустые списки — системный минимум; широкое наследование process.env отключено.
WORKER_PROJECT_ENV_ALLOWLIST=
WORKER_CODEX_ENV_ALLOWLIST=
WORKER_GIT_ENV_ALLOWLIST=

# Не добавляйте токены управления worker. Только точные необходимые имена.
# WORKER_PROJECT_ENV_ALLOWLIST=NODE_ENV,APP_TEST_BASE_URL,JAVA_HOME
# WORKER_CODEX_ENV_ALLOWLIST=HTTPS_PROXY,NO_PROXY,OPENAI_BASE_URL
# WORKER_GIT_ENV_ALLOWLIST=HTTPS_PROXY,NO_PROXY,SSL_CERT_FILE
# Значения перечисленных переменных задайте отдельно в окружении worker.
# Разрешение секрета приложения делает его доступным коду тестов/сборки.
