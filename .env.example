TRACKER_TOKEN=tracker-token
TRACKER_ORG_ID=tracker-org-id
TRACKER_ORG_HEADER=X-Cloud-Org-ID
TRACKER_DEFAULT_QUEUE=FRONTEND
TRACKER_TAG=ai_dev
TRACKER_API_BASE_URL=https://api.tracker.yandex.net/v3
# Path to a JSON file with Tracker logical statuses and transition hints.
TRACKER_STATUS_MAP_FILE=./config/trackerStatusMap.example.json
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=gitlab-token
GITLAB_PROJECT_ID=123
# Used by docker compose example for the bind mount source on the host.
TARGET_REPO_PATH=C:/ABSOLUTE/PATH/TO/YOUR/PROJECT
REPO_PATH=/workspace/project
BASE_BRANCH=main
POLL_INTERVAL_MINUTES=30
# Writable Codex home inside the container or local environment.
CODEX_HOME=/codex-home
# Binary or launcher used to start Codex.
# Usually just `codex`.
# If you need a wrapper launcher, use `node` here and pass the script path via CODEX_CLI_ARGS_JSON.
CODEX_CLI_COMMAND=codex
# JSON array of arguments for the launcher itself, before `exec`.
# Most setups should keep this empty: []
# Example for a Node-based launcher:
# CODEX_CLI_COMMAND=node
# CODEX_CLI_ARGS_JSON=["/absolute/path/to/codex-wrapper.cjs"]
CODEX_CLI_ARGS_JSON=[]
# Optional explicit Codex model, for reproducible runs.
# Leave empty to use Codex defaults or profile settings.
CODEX_MODEL=
# Optional profile name from ~/.codex/config.toml.
# Use this when you already maintain Codex settings in a named profile.
CODEX_PROFILE=
# Sandbox mode for commands generated by Codex inside the worker.
# Recommended for this worker: danger-full-access
CODEX_SANDBOX=danger-full-access
# Extra arguments passed to `codex exec` itself.
# This is NOT for the launcher command above.
# Most setups should keep this empty: []
# Example:
# CODEX_EXEC_ARGS_JSON=["--search","--add-dir","/workspace/shared"]
CODEX_EXEC_ARGS_JSON=[]
# Worker expects Codex to ask for clarification by returning exactly one line
# that starts with this marker.
CODEX_QUESTION_MARKER=AI_QUESTION:
TEST_COMMAND=npm test
LINT_COMMAND=npm run lint
MAX_FIX_ATTEMPTS=2
WORKER_ID=worker-1
WORKER_RUN_ONCE=false
