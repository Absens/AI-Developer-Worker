TRACKER_TOKEN=tracker-token
TRACKER_ORG_ID=tracker-org-id
TRACKER_ORG_HEADER=X-Cloud-Org-ID
TRACKER_TAG=ai_dev
TRACKER_API_BASE_URL=https://api.tracker.yandex.net/v3
# In TRACKER_STATUS_MAP, statuses identify the current issue state.
# transition is only a hint for matching a valid workflow transition returned by Tracker.
TRACKER_STATUS_MAP={"open":{"statuses":["Open"]},"in_progress":{"statuses":["In Progress"],"transition":"start"},"waiting_for_answer":{"statuses":["Waiting for answer"],"transition":"need-info"},"review":{"statuses":["In Review"],"transition":"review"},"failed":{"statuses":["Failed"],"transition":"fail"},"done":{"statuses":["Done"],"transition":"done"}}
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=gitlab-token
GITLAB_PROJECT_ID=123
# Used by docker compose example for the bind mount source on the host.
TARGET_REPO_PATH=C:/ABSOLUTE/PATH/TO/YOUR/PROJECT
REPO_PATH=/workspace/project
BASE_BRANCH=main
POLL_INTERVAL_MINUTES=30
CODEX_HOME=/codex-home
CODEX_CLI_COMMAND=codex
CODEX_COMMAND=codex exec
CODEX_QUESTION_MARKER=AI_QUESTION:
TEST_COMMAND=npm test
LINT_COMMAND=npm run lint
MAX_FIX_ATTEMPTS=2
WORKER_ID=worker-1
WORKER_RUN_ONCE=false
