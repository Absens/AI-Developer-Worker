TRACKER_TOKEN=tracker-token
TRACKER_ORG_ID=tracker-org-id
TRACKER_ORG_HEADER=X-Cloud-Org-ID
TRACKER_DEFAULT_QUEUE=FRONTEND
TRACKER_TAG=ai_dev
TRACKER_API_BASE_URL=https://api.tracker.yandex.net/v3
# Path to a JSON file with Tracker logical statuses and transition hints.
TRACKER_STATUS_MAP_FILE=./config/trackerStatusMap.example.json
# Download Yandex Tracker image attachments and pass them to Codex with --image.
TRACKER_IMAGE_CONTEXT_ENABLED=true
TRACKER_IMAGE_CONTEXT_MAX_COUNT=5
TRACKER_IMAGE_CONTEXT_MAX_BYTES=10485760
# Optional temp directory outside the target git checkout.
# TRACKER_IMAGE_CONTEXT_TEMP_DIR=/tmp/ai-developer-tracker-images
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=gitlab-token
GITLAB_PROJECT_ID=123
GIT_REMOTE_NAME=origin
# Optional dedicated token for git fetch/pull/push over HTTPS.
# Defaults to GITLAB_TOKEN when omitted.
# GIT_REPOSITORY_TOKEN=git-repository-token
# Optional git username for GitLab HTTPS auth. For PAT/project/group access tokens keep oauth2.
# GIT_REPOSITORY_USERNAME=oauth2
# Optional explicit HTTPS remote URL override if the mounted repo uses an SSH remote.
# GIT_REPOSITORY_URL=https://gitlab.example.com/group/project.git
# Skip target-repo pre-commit hooks for worker-generated commits by default.
# Set to false only if you explicitly want the worker to honor repository hooks.
GIT_COMMIT_NO_VERIFY=true
# Optional git commit identity for the worker. If omitted, configure user.name/user.email
# in the mounted repository instead.
# GIT_AUTHOR_NAME=AI Worker
# GIT_AUTHOR_EMAIL=ai-worker@example.com
# Used by docker compose for automatic Codex auth bootstrap on first start.
HOST_CODEX_HOME=C:/Users/YOUR_USER/.codex
# Used by docker compose for the bind mount source on the host.
TARGET_REPO_PATH=C:/ABSOLUTE/PATH/TO/YOUR/PROJECT
REPO_PATH=/workspace/project
BASE_BRANCH=main
POLL_INTERVAL_MINUTES=30
# Optional multi-repository fleet config. When omitted, the worker uses this .env
# as a single default repository profile.
# WORKER_CONFIG_FILE=/workspace/worker.config.yaml
# Use "none" for a single worker if you do not want AI LEASE comments in Tracker.
# Keep "tracker" when multiple workers need task/repository coordination.
# Redis/PostgreSQL values fail fast until those backends are implemented.
LOCK_BACKEND=tracker
LOCK_TTL_SECONDS=900
LOCK_HEARTBEAT_SECONDS=60
# LOCK_REDIS_URL=
# LOCK_POSTGRES_URL=
# Writable Codex home inside the container or local environment.
CODEX_HOME=/codex-home
# Optional direct non-interactive auth source for Codex CLI.
# If you only have OPENAI_API_KEY, persist it first with:
#   printenv OPENAI_API_KEY | codex login --with-api-key
# CODEX_API_KEY=codex-api-key
# Binary or launcher used to start Codex.
# Usually just `codex`.
# If you need a wrapper launcher, use `node` here and pass the script path via CODEX_CLI_ARGS_JSON.
CODEX_CLI_COMMAND=codex
# JSON array of launcher/global Codex arguments passed before `exec`.
# Most setups should keep this empty: []
# Example for a Node-based launcher:
# CODEX_CLI_COMMAND=node
# CODEX_CLI_ARGS_JSON=["/absolute/path/to/codex-wrapper.cjs"]
# Example for Codex global flags:
# CODEX_CLI_ARGS_JSON=["--search","--ask-for-approval","never"]
CODEX_CLI_ARGS_JSON=[]
# Optional explicit Codex model, for reproducible runs.
# Leave empty to use Codex defaults or profile settings.
CODEX_MODEL=
# Optional profile name from ~/.codex/config.toml.
# Use this when you already maintain Codex settings in a named profile.
CODEX_PROFILE=
# Sandbox mode for commands generated by Codex inside the worker.
# Recommended for this worker: danger-full-access
CODEX_SANDBOX=danger-full-access
# Extra arguments passed to `codex exec` itself.
# This is NOT for launcher/global flags such as --search or --ask-for-approval.
# Most setups should keep this empty: []
# Example:
# CODEX_EXEC_ARGS_JSON=["--add-dir","/workspace/shared"]
CODEX_EXEC_ARGS_JSON=[]
# Hard timeout for a single `codex exec` process.
CODEX_TIMEOUT_SECONDS=1800
# Heartbeat log interval while `codex exec` is running.
CODEX_PROGRESS_LOG_INTERVAL_SECONDS=30
# Set to true to mirror full JSONL events from `codex exec --json` into container logs.
# Useful for debugging what Codex is doing between heartbeat lines.
CODEX_LOG_FULL_EVENTS=false
# Worker expects Codex to ask for clarification by returning exactly one line
# that starts with this marker.
CODEX_QUESTION_MARKER=AI_QUESTION:
# Phase 4 task routing. auto uses structured AI_ANALYSIS decisions.
# implement forces implementation after analysis, decompose forces decomposition,
# analyze_only writes analysis metadata and stops, human parks tasks for manual review.
TASK_MODE=auto
CONFIDENCE_IMPLEMENT_THRESHOLD=70
CONFIDENCE_HUMAN_THRESHOLD=40
CONFIDENCE_PRIORITY_WEIGHT=2
# Decomposition mode settings.
DECOMPOSITION_MAX_SUBTASKS=8
DECOMPOSITION_CREATE_ISSUES=true
DECOMPOSITION_DRY_RUN=false
DECOMPOSITION_DEFAULT_SUBTASK_TAG=ai_dev
DECOMPOSITION_SUBTASK_TITLE_PREFIX=[AI split]
# Tracker link type names differ between installations.
TRACKER_PARENT_LINK_TYPE=relates
TRACKER_BLOCKED_BY_LINK_TYPE=is blocked by
# Dependency enforcement skips tasks blocked by open/unknown dependencies.
DEPENDENCY_ENFORCEMENT=true
DEPENDENCY_UNKNOWN_STATUS_POLICY=block
# Phase 7 internal tracker. Leave provider=yandex to keep direct Yandex fallback.
# For production internal mode, use TASK_TRACKER_STORAGE=postgres and run:
#   npm run tracker:migrate
TASK_TRACKER_PROVIDER=yandex
# TASK_TRACKER_PROVIDER=internal
TASK_TRACKER_STORAGE=postgres
TASK_INTAKE_MODE=standalone
YANDEX_SYNC_ENABLED=false
TASK_TRACKER_DATABASE_URL=postgres://tracker:tracker@postgres:5432/ai_developer_tasks
TASK_TRACKER_RETENTION_RAW_LOG_DAYS=30
TASK_TRACKER_RETENTION_ARTIFACT_DAYS=30
TASK_TRACKER_RETENTION_FAILED_ARTIFACT_DAYS=90
TASK_TRACKER_RETENTION_HISTORY_DAYS=365
TASK_TRACKER_CLEANUP_ENABLED=true
TASK_TRACKER_CLEANUP_INTERVAL_SECONDS=3600
TASK_TRACKER_METRICS_ENABLED=true
TASK_TRACKER_REDACTION_ENABLED=true
# Phase 7G AI proposals. Proposals are enabled by default, but autonomous
# execution stays off unless both global and repository policy explicitly allow it.
AI_PROPOSALS_ENABLED=true
AUTO_EXECUTE_LOW_RISK_ENABLED=false
AI_PROPOSAL_ALLOWED_TASK_TYPES_JSON=["documentation","tests_only","dependency_update"]
AI_PROPOSAL_DAILY_LIMIT=20
AI_PROPOSAL_WINDOW_LIMIT=5
AI_PROPOSAL_WINDOW_SECONDS=3600
# Phase 5 memory MVP. Disabled by default; enable only after validating the local memory dir.
MEMORY_ENABLED=false
MEMORY_DIR=/workspace/ai-developer-memory
MEMORY_MAX_CONTEXT_CHARS=6000
MEMORY_STRICT=false
MEMORY_INCLUDE_DRAFT_RULES=false
MEMORY_SIMILAR_FAILURE_LIMIT=3
MEMORY_BOOTSTRAP_ON_START=false
MEMORY_REFRESH_ON_PREFLIGHT=false
MEMORY_BOOTSTRAP_CODEX_SANDBOX=inherit
# Phase 6 observability. Disabled by default; enable metrics first, then dashboard/alerts.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=9464
OBSERVABILITY_BASE_URL=http://localhost:9464
OBSERVABILITY_STRICT_STARTUP=true
OBSERVABILITY_REDACT_MAX_CHARS=4000
METRICS_ENABLED=true
METRICS_PATH=/metrics
HEALTH_PATH=/healthz
READY_PATH=/readyz
OBSERVABILITY_EVENT_STORE=memory
# OBSERVABILITY_EVENT_STORE_FILE=/workspace/ai-developer-events/events.jsonl
OBSERVABILITY_EVENT_RETENTION=1000
DASHBOARD_ENABLED=false
DASHBOARD_PATH=/dashboard
DASHBOARD_REFRESH_SECONDS=10
DASHBOARD_API_PATH=/api
# DASHBOARD_BEARER_TOKEN=
ALERTS_ENABLED=false
ALERT_CHANNELS=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=warning
ALERT_DEDUP_WINDOW_SECONDS=900
ALERT_QUEUE_BLOCKED_CYCLES=3
ALERT_CODEX_TIMEOUT_WINDOW_SECONDS=3600
ALERT_CODEX_TIMEOUT_THRESHOLD=3
ALERT_VALIDATION_FAILURE_WINDOW_SECONDS=3600
ALERT_VALIDATION_FAILURE_THRESHOLD=3
ALERT_WORKER_STALE_SECONDS=300
TEST_COMMAND=npm test
LINT_COMMAND=npm run lint
# Optional ordered quality gates. Empty values skip the gate.
# Execution order: typecheck -> lint -> tests -> build -> security_scan -> sast -> coverage -> visual_regression.
# TYPE_CHECK_COMMAND=npm run typecheck
# BUILD_COMMAND=npm run build
# SECURITY_SCAN_COMMAND=npm audit --audit-level=high
# SAST_COMMAND=semgrep ci
# COVERAGE_COMMAND=npm run test:coverage -- --reporter=json
# MIN_COVERAGE_PERCENT=80
# COVERAGE_REPORT_FILE=coverage/coverage-summary.json
# VISUAL_REGRESSION_COMMAND=npm run test:visual
# VISUAL_REGRESSION_ARTIFACTS_DIR=playwright-report
MAX_FIX_ATTEMPTS=2
# Optional review-feedback fix attempts. Defaults to MAX_FIX_ATTEMPTS when omitted.
# MAX_REVIEW_FIX_ATTEMPTS=2
WORKER_ID=worker-1
WORKER_RUN_ONCE=false
# Run preflight checks only and exit without processing Tracker issues.
WORKER_PREFLIGHT_ONLY=false
# Optional sandbox issue for a neutral preflight comment write check.
# TRACKER_PREFLIGHT_ISSUE_KEY=FRONTEND-42
# Optional sandbox source branch for a draft/test GitLab MR write check.
# GITLAB_PREFLIGHT_SOURCE_BRANCH=preflight/worker-check
# Set to false to skip TEST_COMMAND and LINT_COMMAND during preflight.
PREFLIGHT_RUN_TARGET_COMMANDS=true
# Optional manual mode: process only this Tracker issue instead of scanning the queue.
# TARGET_ISSUE_KEY=FRONTEND-42
