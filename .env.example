# Пример окружения AI Developer Worker. Документация: docs/README.md и docs/ENV_CONFIGURATION.md.
# Значения демонстрационные; замените токены и пути, не коммитьте заполненный .env.
TRACKER_TOKEN=tracker-token
TRACKER_ORG_ID=tracker-org-id
TRACKER_ORG_HEADER=X-Cloud-Org-ID
TRACKER_DEFAULT_QUEUE=FRONTEND
TRACKER_TAG=ai_dev
TRACKER_API_BASE_URL=https://api.tracker.yandex.net/v3
# Путь к JSON-карте логических статусов и переходов Yandex Tracker.
TRACKER_STATUS_MAP_FILE=./config/trackerStatusMap.example.json
# Скачивать изображения из задач Yandex Tracker и передавать Codex через --image.
TRACKER_IMAGE_CONTEXT_ENABLED=true
TRACKER_IMAGE_CONTEXT_MAX_COUNT=5
TRACKER_IMAGE_CONTEXT_MAX_BYTES=10485760
# Необязательный временный каталог вне целевого Git checkout.
# TRACKER_IMAGE_CONTEXT_TEMP_DIR=/tmp/ai-developer-tracker-images
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=gitlab-token
GITLAB_PROJECT_ID=123
GIT_REMOTE_NAME=origin
# Отдельный токен для git fetch/pull/push по HTTPS (необязательно).
# Если не задан, используется GITLAB_TOKEN.
# GIT_REPOSITORY_TOKEN=git-repository-token
# Имя пользователя для HTTPS GitLab; для PAT/project/group token обычно oauth2.
# GIT_REPOSITORY_USERNAME=oauth2
# HTTPS URL remote, если checkout использует SSH remote.
# GIT_REPOSITORY_URL=https://gitlab.example.com/group/project.git
# По умолчанию пропускать pre-commit и pre-push hooks целевого репозитория.
# Устанавливайте false только при осознанном требовании выполнять hooks.
GIT_COMMIT_NO_VERIFY=true
# При необходимости задайте имя/почту автора коммитов. Иначе настройте user.name/user.email
# в монтируемом репозитории.
# GIT_AUTHOR_NAME=AI Worker
# GIT_AUTHOR_EMAIL=ai-worker@example.com
# Используется Compose для первоначального копирования авторизации Codex с хоста.
HOST_CODEX_HOME=C:/Users/YOUR_USER/.codex
# Источник bind mount целевого репозитория в Docker Compose.
TARGET_REPO_PATH=C:/ABSOLUTE/PATH/TO/YOUR/PROJECT
# Локальный override для checkout warehouse-front в режиме fleet.
WAREHOUSE_FRONT_REPO_PATH=C:/ABSOLUTE/PATH/TO/warehouse-front
REPO_PATH=/workspace/project
BASE_BRANCH=main
POLL_INTERVAL_MINUTES=30
# Необязательный fleet YAML/JSON: если не задан, воркер использует этот .env
# как профиль одного репозитория.
# WORKER_CONFIG_FILE=/workspace/worker.config.yaml
# Для единственного воркера можно выбрать "none", чтобы не создавать AI LEASE в Tracker.
# При нескольких воркерах используйте "tracker" для координации задач и репозиториев.
# Redis/PostgreSQL в legacy LOCK_BACKEND не реализованы: запуск завершится ошибкой.
LOCK_BACKEND=tracker
LOCK_TTL_SECONDS=900
LOCK_HEARTBEAT_SECONDS=60
# LOCK_REDIS_URL=
# LOCK_POSTGRES_URL=
# Writable CODEX_HOME внутри контейнера или локального окружения.
CODEX_HOME=/codex-home
# Необязательный источник неинтерактивной авторизации Codex CLI.
# Если есть только OPENAI_API_KEY, предварительно сохраните его через:
#   printenv OPENAI_API_KEY | codex login --with-api-key
# CODEX_API_KEY=codex-api-key
# Исполняемый файл или launcher для запуска Codex.
# Обычно достаточно `codex`.
# Для wrapper launcher можно использовать `node` и передать script через CODEX_CLI_ARGS_JSON.
CODEX_CLI_COMMAND=codex
# JSON-массив глобальных аргументов Codex, которые идут до `exec`.
# В большинстве случаев оставьте пустой массив: []
# Пример запуска через Node.js:
# CODEX_CLI_COMMAND=node
# CODEX_CLI_ARGS_JSON=["/absolute/path/to/codex-wrapper.cjs"]
# Пример глобальных аргументов Codex CLI 0.149.1: используйте `never` или `on-request`;
# не используйте устаревший `--ask-for-approval on-failure`.
# CODEX_CLI_ARGS_JSON=["--search","--ask-for-approval","never"]
CODEX_CLI_ARGS_JSON=[]
# Необязательная модель Codex для воспроизводимых запусков.
# Пустое значение означает настройки Codex по умолчанию или profile.
CODEX_MODEL=
# Имя профиля из ~/.codex/config.toml (необязательно).
# Используйте при настройках Codex в именованном profile.
CODEX_PROFILE=
# Режим sandbox для команд, выполняемых Codex внутри воркера.
# ВНИМАНИЕ: значение danger-full-access даёт широкие права. Не используйте в production для недоверенного кода без изоляции и контроля секретов.
CODEX_SANDBOX=danger-full-access
# Дополнительные аргументы команды `codex exec`.
# Не используйте здесь глобальные флаги --search и --ask-for-approval.
# В большинстве случаев оставьте пустой массив: []
# Пример:
# CODEX_EXEC_ARGS_JSON=["--add-dir","/workspace/shared"]
CODEX_EXEC_ARGS_JSON=[]
# Необязательная самопроверка Codex перед публикацией MR (не для всех runtime-режимов).
# Выполняет `codex exec review` после успешных локальных quality gates.
CODEX_SELF_REVIEW_ENABLED=false
# Максимальное число попыток исправить блокирующие замечания self-review.
CODEX_SELF_REVIEW_MAX_FIX_ATTEMPTS=1
# Тайм-аут одного процесса `codex exec`.
CODEX_TIMEOUT_SECONDS=1800
# Интервал сообщений heartbeat во время работы `codex exec`.
CODEX_PROGRESS_LOG_INTERVAL_SECONDS=30
# Значение true сохраняет все JSONL события `codex exec --json` в логах контейнера.
# Используйте лишь для диагностики: события могут содержать чувствительные данные.
CODEX_LOG_FULL_EVENTS=false
# Для уточнения задачи Codex должен вернуть ровно одну строку
# с указанным ниже маркером.
CODEX_QUESTION_MARKER=AI_QUESTION:
# Маршрутизация: auto использует структурированное решение AI_ANALYSIS.
# implement запускает реализацию, decompose — декомпозицию,
# analyze_only сохраняет анализ, human переводит задачу на ручное рассмотрение.
TASK_MODE=auto
CONFIDENCE_IMPLEMENT_THRESHOLD=70
CONFIDENCE_HUMAN_THRESHOLD=40
CONFIDENCE_PRIORITY_WEIGHT=2
# Настройки декомпозиции задач.
DECOMPOSITION_MAX_SUBTASKS=8
DECOMPOSITION_CREATE_ISSUES=true
DECOMPOSITION_DRY_RUN=false
DECOMPOSITION_DEFAULT_SUBTASK_TAG=ai_dev
DECOMPOSITION_SUBTASK_TITLE_PREFIX=[AI split]
# Типы связей Tracker зависят от конкретной установки.
TRACKER_PARENT_LINK_TYPE=relates
TRACKER_BLOCKED_BY_LINK_TYPE=is blocked by
# Не брать задачи с открытыми/неизвестными блокирующими зависимостями.
DEPENDENCY_ENFORCEMENT=true
DEPENDENCY_UNKNOWN_STATUS_POLICY=block
# Внутренний трекер: provider=yandex сохраняет прямой fallback на Yandex Tracker.
# Для production internal mode используйте PostgreSQL и примените миграции:
#   npm run tracker:migrate
TASK_TRACKER_PROVIDER=yandex
# TASK_TRACKER_PROVIDER=internal
TASK_TRACKER_STORAGE=postgres
TASK_INTAKE_MODE=standalone
YANDEX_SYNC_ENABLED=false
TASK_TRACKER_DATABASE_URL=postgres://tracker:tracker@postgres:5432/ai_developer_tasks
TASK_TRACKER_RETENTION_RAW_LOG_DAYS=30
TASK_TRACKER_RETENTION_ARTIFACT_DAYS=30
TASK_TRACKER_RETENTION_FAILED_ARTIFACT_DAYS=90
TASK_TRACKER_RETENTION_HISTORY_DAYS=365
TASK_TRACKER_CLEANUP_ENABLED=true
TASK_TRACKER_CLEANUP_INTERVAL_SECONDS=3600
TASK_TRACKER_METRICS_ENABLED=true
TASK_TRACKER_REDACTION_ENABLED=true
# AI proposals включены по умолчанию, однако самостоятельное
# исполнение запрещено до разрешения глобальной и проектной политикой.
AI_PROPOSALS_ENABLED=true
AUTO_EXECUTE_LOW_RISK_ENABLED=false
AI_PROPOSAL_ALLOWED_TASK_TYPES_JSON=["documentation","tests_only","dependency_update"]
AI_PROPOSAL_DAILY_LIMIT=20
AI_PROPOSAL_WINDOW_LIMIT=5
AI_PROPOSAL_WINDOW_SECONDS=3600
# Project Manager по умолчанию выключен. Для анализа, целей и task proposals
# требуется TASK_TRACKER_PROVIDER=internal; действия контролируются политикой.
# По умолчанию работает proposal_only, без неограниченного автозапуска задач.
PROJECT_MANAGER_ENABLED=false
PROJECT_MANAGER_RUN_ONCE=false
PROJECT_MANAGER_INTERVAL_MINUTES=1440
PROJECT_MANAGER_FOCUS_AREAS_JSON=[]
PROJECT_MANAGER_MAX_GOALS_PER_RUN=5
PROJECT_MANAGER_MAX_TASK_PROPOSALS_PER_GOAL=5
PROJECT_MANAGER_DEFAULT_AUTONOMY_LEVEL=proposal_only
PROJECT_MANAGER_AUTO_APPROVE_LOW_RISK=false
PROJECT_MANAGER_ALLOWED_TASK_TYPES_JSON=["documentation","tests_only","dependency_update"]
PROJECT_MANAGER_REPOSITORY_SCAN_ENABLED=false
PROJECT_MANAGER_REPOSITORY_SCAN_MAX_FILES=200
PROJECT_MANAGER_REQUIRE_HUMAN_GOAL_APPROVAL=true
# Локальная память выключена; перед включением проверьте каталог и schema.
MEMORY_ENABLED=false
MEMORY_DIR=/workspace/ai-developer-memory
MEMORY_MAX_CONTEXT_CHARS=6000
MEMORY_STRICT=false
MEMORY_INCLUDE_DRAFT_RULES=false
MEMORY_SIMILAR_FAILURE_LIMIT=3
MEMORY_BOOTSTRAP_ON_START=false
MEMORY_REFRESH_ON_PREFLIGHT=false
MEMORY_BOOTSTRAP_CODEX_SANDBOX=inherit
# Наблюдаемость выключена; сначала включите метрики, затем alerts.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=9464
OBSERVABILITY_BASE_URL=http://localhost:9464
OBSERVABILITY_STRICT_STARTUP=true
OBSERVABILITY_REDACT_MAX_CHARS=4000
METRICS_ENABLED=true
METRICS_PATH=/metrics
HEALTH_PATH=/healthz
READY_PATH=/readyz
OBSERVABILITY_EVENT_STORE=memory
# OBSERVABILITY_EVENT_STORE_FILE=/workspace/ai-developer-events/events.jsonl
OBSERVABILITY_EVENT_RETENTION=1000
ALERTS_ENABLED=false
ALERT_CHANNELS=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=warning
ALERT_DEDUP_WINDOW_SECONDS=900
ALERT_QUEUE_BLOCKED_CYCLES=3
ALERT_CODEX_TIMEOUT_WINDOW_SECONDS=3600
ALERT_CODEX_TIMEOUT_THRESHOLD=3
ALERT_VALIDATION_FAILURE_WINDOW_SECONDS=3600
ALERT_VALIDATION_FAILURE_THRESHOLD=3
ALERT_WORKER_STALE_SECONDS=300
TEST_COMMAND=npm test
LINT_COMMAND=npm run lint
# Необязательные quality gates выполняются по порядку; пустые команды пропускаются.
# Порядок: typecheck -> lint -> tests -> build -> security_scan -> sast -> coverage -> visual_regression.
# TYPE_CHECK_COMMAND=npm run typecheck
# BUILD_COMMAND=npm run build
# SECURITY_SCAN_COMMAND=npm audit --audit-level=high
# SAST_COMMAND=semgrep ci
# COVERAGE_COMMAND=npm run test:coverage -- --reporter=json
# MIN_COVERAGE_PERCENT=80
# COVERAGE_REPORT_FILE=coverage/coverage-summary.json
# VISUAL_REGRESSION_COMMAND=npm run test:visual
# VISUAL_REGRESSION_ARTIFACTS_DIR=playwright-report
MAX_FIX_ATTEMPTS=2
# Лимит исправлений по review feedback (по умолчанию MAX_FIX_ATTEMPTS).
# MAX_REVIEW_FIX_ATTEMPTS=2
WORKER_ID=worker-1
WORKER_RUN_ONCE=false
# Только preflight, без обработки задач и изменений в Tracker.
WORKER_PREFLIGHT_ONLY=false
# Тестовая задача для проверки права записи комментария при preflight.
# TRACKER_PREFLIGHT_ISSUE_KEY=FRONTEND-42
# Тестовая ветка для проверки GitLab MR write при preflight.
# GITLAB_PREFLIGHT_SOURCE_BRANCH=preflight/worker-check
# false пропускает TEST_COMMAND и LINT_COMMAND при preflight.
PREFLIGHT_RUN_TARGET_COMMANDS=true
# Ручной режим: обрабатывать только указанную задачу вместо общей очереди.
# TARGET_ISSUE_KEY=FRONTEND-42
